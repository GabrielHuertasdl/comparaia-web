# Database
DATABASE_URL="postgresql://user:password@localhost:5432/comparaia"

# Authentication
JWT_SECRET="change-me-to-a-secure-random-string-min-32-chars"

# Admin setup (first admin user)
ADMIN_EMAIL="admin@comparaia.es"
ADMIN_PASSWORD="change-me-secure-password"

# Site
NEXT_PUBLIC_SITE_URL="https://comparaia.es"
NEXT_PUBLIC_SITE_NAME="ComparaIA"

# Revalidation webhook secret
REVALIDATE_SECRET="change-me-to-a-secure-random-string"

# Analytics (optional, cookieless)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="comparaia.es"

# IndexNow (optional, for faster indexing)
INDEXNOW_KEY=""

# Cookie consent policy version
NEXT_PUBLIC_COOKIE_POLICY_VERSION="2025.1"
